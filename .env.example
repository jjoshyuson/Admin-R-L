# Copy to .env.local. Never commit real credentials.
# Browser configuration: use the public anon/publishable key, never a service-role key.
VITE_SUPABASE_URL=https://jlhejqrvufylfodsreit.supabase.co
VITE_SUPABASE_ANON_KEY=replace_with_supabase_public_anon_key
VITE_SUPABASE_STORAGE_BUCKET=menu-icons

# Google OAuth setup reference for later; these are NOT read by the current frontend.
# For hosted Supabase, enter these values in Authentication > Sign In / Providers > Google.
# Do NOT rename the secret to VITE_GOOGLE_CLIENT_SECRET: VITE_ variables are public.
GOOGLE_CLIENT_ID=replace_with_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Google Cloud > Web application OAuth client:
